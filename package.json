{
  "$schema": "https://json.schemastore.org/package",
  "name": "mspixelpulse-backend",
  "description": "Official MSPixelPulse backend API for authentication, users, agency projects, client workspaces, messaging, billing, portfolio content, and secure file workflows.",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:demo": "node src/scripts/seedDemo.js",
    "seed:super-admin": "node src/scripts/seedSuperAdmin.js",
    "seed:portal-demo": "node src/scripts/seedPortalDemo.js",
    "seed:demo-invoice": "node src/scripts/seedDemoInvoice.js",
    "seed:projects": "node src/scripts/seedProjects.js",
    "seed:content": "node src/scripts/seedContent.js",
    "normalize:portal:dry": "node --env-file=.env src/scripts/normalizePortalAccounts.js",
    "normalize:portal": "node --env-file=.env src/scripts/normalizePortalAccounts.js --confirm",
    "test:google-provider": "node --env-file=.env src/scripts/googleProviderSmokeTest.js",
    "verify:google-runtime": "DATA_PROVIDER=google STORAGE_PROVIDER=google-drive node --env-file=.env src/scripts/verifyGoogleRuntime.js --confirm-production"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^174.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
