# .env.example

NODE_ENV=development
PORT=5000

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:5173,https://mspixelpulse.com,https://www.mspixelpulse.com

# Production data/storage providers
DATA_PROVIDER=google
STORAGE_PROVIDER=google-drive

# Keep a short bounded cache for normal Google Sheets reads.
# Authentication/user credential reads bypass this cache automatically.
GOOGLE_SHEETS_CACHE_TTL_MS=5000

# Google OAuth server credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# MSPixelPulse production Google Sheets database
GOOGLE_DATABASE_SPREADSHEET_ID=

# MSPixelPulse production Google Drive hierarchy
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_FILES_FOLDER_ID=
GOOGLE_DRIVE_PROJECT_FILES_FOLDER_ID=

# Optional isolated smoke-test resources only.
# Never point these values to production resources.
GOOGLE_PHASE1_TEST_SPREADSHEET_ID=
GOOGLE_PHASE1_TEST_DRIVE_ROOT_FOLDER_ID=

# Production email provider
RESEND_API_KEY=
RESEND_FROM_EMAIL="MSPixelPulse <info@mspixelpulse.com>"

PUBLIC_SITE_URL=https://mspixelpulse.com
API_PUBLIC_BASE=https://api.mspixelpulse.com

ANONYMOUS_ID_SALT=replace-with-long-random-secret

NOTIFICATION_RECIPIENTS=info@mspixelpulse.com,mspixelpulse@gmail.com
CONTACT_RECIPIENTS=info@mspixelpulse.com,mspixelpulse@gmail.com
BLOG_NOTIFICATION_RECIPIENTS=info@mspixelpulse.com,mspixelpulse@gmail.com

BLOG_EMAIL_NOTIFICATIONS=true
BLOG_LIKE_EMAILS=true
BLOG_DISLIKE_EMAILS=true
BLOG_COMMENT_EMAILS=true
BLOG_SHARE_EMAILS=true
BLOG_SUBSCRIBE_EMAILS=true

CONTACT_EMAIL_NOTIFICATIONS=true
CONTACT_CONFIRMATION_EMAILS=true

ENABLE_DEBUG_ROUTES=false
DEBUG_ROUTE_KEY=

ADMIN_EMAIL=admin@mspixel.pulse
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_NAME=Admin User
# Portal operational notifications (recipient is intentionally singular)
PORTAL_OPERATIONAL_NOTIFICATION_EMAIL=mspixelpulse@gmail.com

# One-time Gmail label/filter provisioning. Use a dedicated OAuth consent grant
# for mspixelpulse@gmail.com with gmail.labels and gmail.settings.basic scopes.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost
