NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:5173,https://mspixelpulse.com,https://www.mspixelpulse.com,https://mspixelpulse.vercel.app

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret
SUPABASE_BUCKET=uploads

# Production email provider. Uses HTTPS and avoids SMTP port issues.
RESEND_API_KEY=
RESEND_FROM_EMAIL="MSPixelPulse <info@mspixelpulse.com>"

PUBLIC_SITE_URL=https://mspixelpulse.com
ANONYMOUS_ID_SALT=replace-with-long-random-secret
NOTIFICATION_RECIPIENTS=info@mspixelpulse.com,mspixelpulse@gmail.com
CONTACT_RECIPIENTS=info@mspixelpulse.com,mspixelpulse@gmail.com
BLOG_NOTIFICATION_RECIPIENTS=info@mspixelpulse.com,mspixelpulse@gmail.com

BLOG_EMAIL_NOTIFICATIONS=true
BLOG_LIKE_EMAILS=true
BLOG_DISLIKE_EMAILS=true
BLOG_COMMENT_EMAILS=true
BLOG_SHARE_EMAILS=true
BLOG_SUBSCRIBE_EMAILS=true
CONTACT_EMAIL_NOTIFICATIONS=true
CONTACT_CONFIRMATION_EMAILS=true

ENABLE_DEBUG_ROUTES=false
DEBUG_ROUTE_KEY=

ADMIN_EMAIL=admin@mspixel.pulse
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_NAME=Admin User

UPLOAD_DIR=uploads
